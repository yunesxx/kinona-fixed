{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kinona-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-s", ".", "-l", "3000"],
      "port": 3000
    },
    {
      "name": "wasalni-captain",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "wasalni_captain", "-l", "3001"],
      "port": 3001
    },
    {
      "name": "loqta",
      "runtimeExecutable": "node",
      "runtimeArgs": ["../loqta/server.js"],
      "port": 3002
    },
    {
      "name": "touches-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "../touches", "run", "dev"],
      "port": 3000,
      "autoPort": true
    }
  ]
}
